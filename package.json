{
  "name": "backseat-driver",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "dev:public": "node scripts/public.mjs",
    "build": "tsc --noEmit && tsc --noEmit -p worker && vite build",
    "preview": "vite preview",
    "preview:public": "node scripts/public.mjs --preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "serve:worker": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "qrcode": "^1.5.4",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.1"
  },
  "type": "module",
  "private": true
}
